<Project Sdk="Microsoft.NET.Sdk">
    <!-- assembly metadata -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>preview</LangVersion>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <AssemblyName>LoopFromHere</AssemblyName>
        <RootNamespace>LoopFromHere</RootNamespace>
    </PropertyGroup>

    <!-- disable "Copy Local" for all references -->
    <ItemDefinitionGroup>
        <PackageReference PrivateAssets="all" ExcludeAssets="runtime" />
        <Reference Private="false" />
    </ItemDefinitionGroup>

    <!-- references from the om install -->
    <PropertyGroup>
        <OpusMagnumPrefix>..\..\..</OpusMagnumPrefix>
    </PropertyGroup>
    <ItemGroup>
        <Reference Include="$(OpusMagnumPrefix)\DevLightning_LoopFromHere.dll" Private="false"/>
        <Reference Include="$(OpusMagnumPrefix)\Mono.Cecil.dll" Private="false"/>
        <Reference Include="$(OpusMagnumPrefix)\MonoMod.Patcher.dll" Private="false"/>
        <Reference Include="$(OpusMagnumPrefix)\MonoMod.Utils.dll" Private="false"/>
    </ItemGroup>

    <!-- copy files to output directory after building -->
    <Target Name="CopyFiles" AfterTargets="Build" Inputs="$(OutputPath)\$(AssemblyName).dll;$(OutputPath)\$(AssemblyName).pdb" Outputs="..\bin\$(AssemblyName).dll;..\bin\$(AssemblyName).pdb">
        <Copy SourceFiles="$(OutputPath)\$(AssemblyName).dll" DestinationFolder="..\bin" />
        <Copy SourceFiles="$(OutputPath)\$(AssemblyName).pdb" DestinationFolder="..\bin" />
    </Target>
</Project>
